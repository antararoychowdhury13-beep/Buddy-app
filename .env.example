# Everything below is OPTIONAL. With none of it set, `npm run dev` boots Buddy
# in DEMO MODE: a fully seeded, in-memory day (calendar, weather, nudges,
# trust history, facts) so every screen is populated with no external services.
# Fill these in to swap the demo for real data, one integration at a time.

# Real database — set BOTH to leave demo mode and persist to Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Turns on full conversational Ask/Chat + LLM-composed briefings. Without it,
# Buddy answers from your day's data with a built-in local responder.
ANTHROPIC_API_KEY=
# Which single user this prototype runs as. Defaults to the demo user.
BUDDY_USER_EMAIL=you@example.com
PORT=3000

# Google Calendar OAuth app credentials (see README's Connectors section).
# The connection itself (refresh token) is managed from the Me page, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional one-time bootstrap only: if set before the connector has ever been
# connected, these seed the initial connection so you don't have to use the
# Me page on a fresh setup. Safe to leave blank — connect from Me instead.
GOOGLE_REFRESH_TOKEN=
OPENWEATHER_API_KEY=
WEATHER_LOCATION=Bengaluru,IN

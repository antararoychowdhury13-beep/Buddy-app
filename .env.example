SUPABASE_URL=
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
BUDDY_USER_EMAIL=you@example.com
PORT=3000

# Google Calendar OAuth app credentials (see README's Connectors section).
# The connection itself (refresh token) is managed from the Me page, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional one-time bootstrap only: if set before the connector has ever been
# connected, these seed the initial connection so you don't have to use the
# Me page on a fresh setup. Safe to leave blank — connect from Me instead.
GOOGLE_REFRESH_TOKEN=
OPENWEATHER_API_KEY=
WEATHER_LOCATION=Bengaluru,IN

{
  "name": "buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "ingest": "tsx scripts/ingest.ts",
    "auth:google": "tsx scripts/auth-google.ts",
    "test": "tsx scripts/test-trust-engine.ts",
    "test:speech": "tsx scripts/test-speech-smoke.ts",
    "test:stt": "tsx scripts/test-stt-roundtrip.ts",
    "build:homeai": "tsc -p tsconfig.homeai.json",
    "build:homeai:watch": "tsc -p tsconfig.homeai.json --watch",
    "typecheck": "tsc -p tsconfig.scripts.json && tsc -p tsconfig.homeai.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^173.0.0",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
